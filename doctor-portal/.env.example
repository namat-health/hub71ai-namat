DATABASE_URL=postgresql://username:password@host:5432/database_name
# Opt in only after deploying the shared API bridge. Disabled preserves rollback.
NAMAT_SHARED_API_ENABLED=false
NAMAT_SHARED_API_ORIGIN=https://namat-api-staging-uaen-001.azurewebsites.net
NAMAT_SHARED_API_PORTAL_TOKEN=
# Server-only credential for the report source endpoint at start.namat.health.
# Never expose it through NEXT_PUBLIC_ variables or the browser.
NAMAT_REPORT_REVIEW_TOKEN=
# Azure App Service authentication must require Microsoft sign-in on every path.
NAMAT_PORTAL_AUTH_MODE=azure-easy-auth
NAMAT_PORTAL_TENANT_ID=
NAMAT_PORTAL_ALLOWED_USER_IDS=
# Optional: separate AI Lab Review configuration.
OPENAI_API_KEY=
