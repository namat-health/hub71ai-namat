---
import {content} from '../data/content';
const doctor = content.medicalLeadership;
---

<section class="medical-leadership" id="founders" data-medical-leadership aria-labelledby="founders-title">
  <div class="medical-shell">
    <div class="medical-profile">
      <figure class="medical-portrait">
        <img src="/assets/leadership/dr-miguel-gomez-bravo.webp" alt="Dr. Miguel Gómez Bravo" width="622" height="771" loading="lazy" decoding="async" />
      </figure>
      <div class="medical-copy">
        <p class="medical-role">{doctor.role}</p>
        <h2 id="founders-title">Dr. Miguel<br />Gómez Bravo</h2>
        <div class="medical-biography">
          <p class="medical-introduction">{doctor.introduction}</p>
          <p>{doctor.body}</p>
        </div>
        <div class="medical-socials" aria-label="Dr. Bravo’s profiles">
          {doctor.socials.map(social => (
            <a href={social.href} target="_blank" rel="noopener noreferrer" aria-label={`Dr. Miguel Gómez Bravo on ${social.label} (opens in a new tab)`} title={social.label}>
              {social.label === 'LinkedIn' ? (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 2H3.55C2.69 2 2 2.68 2 3.52v16.96c0 .84.69 1.52 1.55 1.52h16.9c.86 0 1.55-.68 1.55-1.52V3.52c0-.84-.69-1.52-1.55-1.52ZM7.93 18.75H4.98V9.2h2.95v9.55ZM6.45 7.9a1.71 1.71 0 1 1 0-3.42 1.71 1.71 0 0 1 0 3.42Zm12.3 10.85H15.8V14.1c0-1.11-.02-2.54-1.55-2.54-1.55 0-1.79 1.21-1.79 2.46v4.73H9.51V9.2h2.83v1.3h.04c.4-.75 1.36-1.55 2.79-1.55 2.99 0 3.58 1.97 3.58 4.53v5.27Z" /></svg>
              ) : (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.25" /><circle cx="17.6" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
              )}
            </a>
          ))}
        </div>
      </div>
    </div>
    <div class="medical-credentials" data-medical-credentials>
      <div class="credential-viewport">
        <div class="credential-track">
          {[false, true].map(duplicate => (
            <ul class:list={['credential-group', {'credential-duplicate': duplicate}]} aria-label={duplicate ? undefined : 'Dr. Bravo’s education and previous clinical experience'} aria-hidden={duplicate ? 'true' : undefined}>
              {doctor.credentials.map(credential => (
                <li class="credential-logo">
                  <img src={`/assets/leadership/${credential.logo}.webp`} alt={`${credential.institution} — ${credential.relationship}: ${credential.detail}`} width="900" height={credential.height} style={`--credential-logo-width:${credential.displayWidth}`} loading="lazy" decoding="async" />
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
      <button class="credential-motion" type="button" data-credential-motion aria-pressed="false" aria-label="Pause credential animation" title="Pause credential animation" hidden>
        <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path class="credential-pause-icon" d="M5 4h3v12H5zm7 0h3v12h-3z" /><path class="credential-play-icon" d="m6 3 10 7-10 7z" /></svg>
      </button>
    </div>
  </div>
</section>

<style>
  .medical-leadership { background: #eeece2; color: #172523; padding: clamp(4.5rem, 7vw, 7rem) var(--page-gutter) clamp(4rem, 6vw, 6rem); scroll-margin-top: 6rem; }
  .medical-shell { max-width: 72rem; margin-inline: auto; }
  .medical-profile { display: grid; grid-template-columns: .9fr 1.1fr; gap: clamp(3rem, 7vw, 7rem); align-items: center; }
  .medical-portrait { position: relative; margin: 0; min-width: 0; aspect-ratio: .85; background: #e4e4d9; overflow: hidden; border-radius: .4rem; }
  .medical-portrait img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; object-position: center bottom; }
  .medical-portrait::after { content: ''; position: absolute; inset: auto 0 0; height: 27%; background: linear-gradient(transparent, #e4e4d9); pointer-events: none; }
  .medical-copy { padding-block: 1rem; min-width: 0; }
  .medical-role { max-width: 44ch; margin-bottom: 1.3rem; color: #a55028; font: 400 .73rem/1.65 var(--mono); text-transform: uppercase; letter-spacing: .065em; }
  .medical-copy h2 { font: 650 clamp(2.8rem, 4.6vw, 4.5rem)/1.025 var(--display); font-stretch: 106%; letter-spacing: -.055em; }
  .medical-biography { border-top: 1px solid #cfcec1; padding-top: 1.55rem; margin-top: 1.9rem; }
  .medical-biography p { max-width: 43ch; color: #596254; font: 400 clamp(1rem, 1.35vw, 1.1rem)/1.55 var(--sans); }
  .medical-biography .medical-introduction { font-size: clamp(1.1rem, 1.55vw, 1.25rem); color: #172523; margin-bottom: 1rem; }
  .medical-socials { display: flex; gap: .75rem; margin-top: 1.5rem; }
  .medical-socials a { display: inline-grid; place-items: center; width: 2.75rem; height: 2.75rem; border: 1px solid #c5c8ba; border-radius: 50%; text-decoration: none; transition: color .2s ease, background .2s ease; }
  .medical-socials svg { width: 1.2rem; height: 1.2rem; }
  .medical-socials a:hover { color: #a55028; background: #e6e4d8; }
  .medical-socials a:focus-visible, .credential-motion:focus-visible { outline: 2px solid #a55028; outline-offset: 5px; }
  .medical-credentials { position: relative; margin-top: clamp(3.5rem, 6vw, 5.5rem); padding-bottom: 2.5rem; }
  .credential-motion { position: absolute; bottom: -.2rem; right: 0; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; padding: .7rem; background: none; border: none; color: #687063; cursor: pointer; }
  .credential-motion svg { width: 1rem; height: 1rem; }
  .credential-play-icon, .is-paused .credential-pause-icon { display: none; }
  .is-paused .credential-play-icon { display: block; }
  .credential-motion[hidden] { display: none; }
  .credential-group { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); align-items: center; gap: 3rem; }
  .credential-duplicate { display: none; }
  .credential-logo { display: flex; justify-content: center; align-items: center; min-width: 0; min-height: 5rem; }
  .credential-logo img { display: block; width: var(--credential-logo-width); max-width: 100%; height: auto; }
  .is-enhanced .credential-viewport { overflow: hidden; -webkit-mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent); mask-image: linear-gradient(90deg, transparent, #000 3%, #000 97%, transparent); }
  .is-enhanced .credential-track { display: flex; width: max-content; animation: credentials-drift 48s linear infinite; animation-play-state: paused; }
  .is-enhanced .credential-group { display: flex; flex-shrink: 0; gap: 4rem; padding-right: 4rem; }
  .is-enhanced .credential-logo { width: 22rem; }
  .is-enhanced.is-visible:not(.is-paused) .credential-track { animation-play-state: running; }
  .is-enhanced .credential-viewport:hover .credential-track { animation-play-state: paused !important; }
  @keyframes credentials-drift { to { transform: translateX(-50%); } }
  @media (max-width: 899px) {
    .medical-profile { gap: 2rem; grid-template-columns: .85fr 1.15fr; }
    .medical-portrait { aspect-ratio: .68; }
    .medical-copy h2 { font-size: clamp(2.5rem, 5vw, 3.5rem); }
    .medical-biography { margin-top: 1.5rem; padding-top: 1.2rem; }
    .credential-group { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .medical-leadership { padding: 3.5rem 5%; }
    .medical-profile { grid-template-columns: 1fr; gap: 2rem; }
    .medical-portrait { aspect-ratio: 1.03; }
    .medical-portrait img { object-fit: contain; }
    .medical-copy { padding-block: 0; }
    .medical-role { margin-bottom: 1.1rem; font-size: .68rem; }
    .medical-copy h2 { font-size: clamp(2.55rem, 11vw, 3.5rem); }
    .medical-biography p { max-width: 36ch; }
    .medical-socials { margin-top: 1.15rem; }
    .medical-credentials { margin-top: 3rem; }
    .is-enhanced .credential-group { gap: 2rem; padding-right: 2rem; }
    .is-enhanced .credential-logo { width: 16rem; min-height: 4.5rem; }
    .credential-logo img { max-width: 90%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .credential-motion, .is-enhanced .credential-duplicate { display: none; }
    .is-enhanced .credential-viewport { overflow: visible; mask-image: none; -webkit-mask-image: none; }
    .is-enhanced .credential-track { display: block; width: auto; animation: none; }
    .is-enhanced .credential-group { display: grid; padding: 0; }
    .is-enhanced .credential-logo { width: auto; }
    .medical-socials a { transition: none; }
  }
</style>

<script>
  const credentials = document.querySelector<HTMLElement>('[data-medical-credentials]');
  if (credentials) {
    const button = credentials.querySelector<HTMLButtonElement>('[data-credential-motion]');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const syncMotion = () => {
      credentials.classList.toggle('is-enhanced', !reducedMotion.matches);
      if (button) button.hidden = reducedMotion.matches;
    };
    button?.addEventListener('click', () => {
      const paused = credentials.classList.toggle('is-paused');
      button.setAttribute('aria-pressed', String(paused));
      const action = paused ? 'Play credential animation' : 'Pause credential animation';
      button.setAttribute('aria-label', action);
      button.title = action;
    });
    const observer = new IntersectionObserver(([entry]) => {
      credentials.classList.toggle('is-visible', entry.isIntersecting);
    });
    observer.observe(credentials);
    reducedMotion.addEventListener('change', syncMotion);
    syncMotion();
  }
</script>
