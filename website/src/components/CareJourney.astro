    .journey-canvas { inset: 43% 0 11%; }
    .journey-era { top: -5.5rem; }
    .journey-cycle-brand { --health-lockup-size: 2.625rem; }
    .journey-return { height: clamp(5rem, 20svh, 8rem); }
