  @supports not (overflow: clip) { .journey-stage { overflow: hidden; } }
</style>

<script>
  import {getJourneyMotion} from '../lib/care-journey-motion.mjs';
  import {getJourneyLayout, getFlowJourneyProgress} from '../lib/journey-layout.mjs';

  const scene = document.querySelector<HTMLElement>('[data-care-journey]');
  if (scene) {
    const stage = scene.querySelector<HTMLElement>('.journey-stage')!;
    const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const flowStages: HTMLElement[] = [];
    const attemptCache = new WeakMap<HTMLElement, HTMLElement[]>();
    let queued = false;
    let enabled = false;
    let layout = '';
    let lastProgress = -1;
    const applyState = (target: HTMLElement, progress: number) => {
      const state = getJourneyMotion(progress);
      for (const [key, value] of Object.entries(state.scene)) target.style.setProperty(`--${key}`, value.toFixed(4));
      if (!attemptCache.has(target)) attemptCache.set(target, Array.from(target.querySelectorAll<HTMLElement>('[data-journey-attempt]')));
      attemptCache.get(target)!.forEach((attempt, index) => {
        for (const [key, value] of Object.entries(state.attempts[index])) {
          const property = key.replace(/[A-Z]/g, letter => `-${letter.toLowerCase()}`);
          attempt.style.setProperty(`--${property}`, value.toFixed(4));
        }
      });
    };
    const render = () => {
      queued = false;
      if (!enabled) return;
      if (layout === 'flow') {
        applyState(stage, 0);
        flowStages.forEach((panel, index) => {
          applyState(panel, getFlowJourneyProgress(index === 0 ? 'today' : 'cycle', panel.getBoundingClientRect().top, panel.offsetHeight, window.innerHeight));
        });
        return;
      }
      const distance = scene.offsetHeight - stage.offsetHeight;
      const progress = Math.max(0, Math.min(1, -scene.getBoundingClientRect().top / Math.max(1, distance)));
      if (progress === lastProgress) return;
      lastProgress = progress;
      applyState(stage, progress);
    };
    const schedule = () => {
      if (queued || !enabled) return;
      queued = true;
      requestAnimationFrame(render);
    };
    // Phone toolbars change innerHeight while scrolling; measure the small viewport instead so the
    // layout never flips between static and pinned mid-scroll.
    const viewportProbe = document.createElement('div');
    viewportProbe.setAttribute('aria-hidden', 'true');
    viewportProbe.style.cssText = 'position:fixed;top:0;left:0;width:0;height:100vh;height:100svh;visibility:hidden;pointer-events:none';
    document.body.appendChild(viewportProbe);
    const configure = () => {
      const nextLayout = getJourneyLayout({width: window.innerWidth, height: viewportProbe.offsetHeight, reducedMotion: motion.matches});
      if (nextLayout === layout) { lastProgress = -1; schedule(); return; }
      layout = nextLayout;
      enabled = layout !== 'static';
      lastProgress = -1;
      scene.classList.toggle('is-enhanced', enabled);
      scene.classList.toggle('is-flow', layout === 'flow');
      if (layout === 'flow' && !flowStages.length) {
        ['today', 'cycle'].forEach(phase => {
          const panel = stage.cloneNode(true) as HTMLElement;
          panel.dataset.journeyPhase = phase;
          stage.parentNode!.insertBefore(panel, scene.querySelector('.journey-readable'));
          flowStages.push(panel);
        });
      }
      if (enabled) schedule();
      else scene.removeAttribute('style');
    };
    window.addEventListener('scroll', schedule, {passive: true});
    window.addEventListener('resize', configure, {passive: true});
    window.addEventListener('pageshow', schedule);
    motion.addEventListener('change', configure);
    configure();
  }
</script>
