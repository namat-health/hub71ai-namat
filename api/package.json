{
  "name": "namat-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "@azure/identity": "4.13.3",
    "@azure/storage-blob": "12.34.0",
    "@cantoo/pdf-lib": "2.11.1",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "sharp": "0.35.5"
  },
  "scripts": {
    "start": "node services/namat-api/server.mjs",
    "dev": "node --env-file=.env.namat-api.local services/namat-api/server.mjs",
    "db:init": "node --env-file=.env.namat-api.local services/namat-api/initialize.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:local": "node --env-file=.env.namat-api.local scripts/test-backend-local.mjs",
    "package:azure": "node scripts/package-namat-api-azure.mjs"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
