# Copy to .env.namat-api.local at the repository root. Use local credentials.
# Never copy Azure URLs, Brevo keys or production secrets into this file.
NAMAT_API_MODE=synthetic-local
NAMAT_API_DATABASE_URL=postgresql://local_user:local_password@127.0.0.1:5432/namat_hackathon
NAMAT_API_SCHEMA=namat_api_dev
NAMAT_API_PORT=4340
NAMAT_API_ALLOWED_ORIGINS=http://127.0.0.1:4340,http://127.0.0.1:4332,http://127.0.0.1:4324
