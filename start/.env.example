# Runtime settings only. See docs/start-form-deployment.md.
HACKATHON_ENABLED=false
HACKATHON_DATABASE_URL=
HACKATHON_DATABASE_CA=
HACKATHON_ALLOWED_ORIGINS=http://localhost:4350,http://127.0.0.1:4350
HACKATHON_EMAIL_MODE=local
HACKATHON_PARTICIPANT_EMAIL_APPROVED=false
NAMAT_REPORTS_ENABLED=false
NAMAT_REPORT_STORAGE_ACCOUNT=
NAMAT_DOCUMENT_ENDPOINT=
NAMAT_OCR_DAILY_PAGE_LIMIT=200
NAMAT_REPORT_REVIEW_TOKEN=
# Local preview only. Never set this in Azure.
NAMAT_REPORT_LOCAL_DIRECTORY=
BREVO_API_KEY=
# Explicit migration switch. Keep off until the shared API bridge is verified.
NAMAT_SHARED_API_ENABLED=false
# Distinct server-only 64-character lowercase hex secrets. Never PUBLIC_.
NAMAT_SHARED_API_INTAKE_TOKEN=
NAMAT_SHARED_API_UPSTREAM_TOKEN=
